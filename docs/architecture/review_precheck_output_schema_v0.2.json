{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://longyuan.example/schemas/review-precheck-v0.2.json",
  "title": "任务交付物验收初判输出 v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_pass",
    "missing_items",
    "requirement_checks",
    "risk_flags",
    "suggested_decision",
    "feedback_draft",
    "confidence"
  ],
  "properties": {
    "format_pass": {
      "type": "boolean",
      "description": "交付物格式是否通过基础检查"
    },
    "missing_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "缺失项目；每项必须使用简体中文"
    },
    "requirement_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status",
          "evidence"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "description": "验收标准，简体中文"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "uncertain"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "证据说明，简体中文"
          }
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "风险提示；必须使用简体中文"
    },
    "suggested_decision": {
      "type": "string",
      "enum": [
        "pass",
        "rework",
        "manual_review"
      ]
    },
    "feedback_draft": {
      "type": "string",
      "description": "给参与者的反馈草案，必须使用简体中文"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "x-language-policy": {
    "locale": "zh-CN",
    "fields": [
      "/missing_items/*",
      "/requirement_checks/*/criterion",
      "/requirement_checks/*/evidence",
      "/risk_flags/*",
      "/feedback_draft"
    ],
    "min_cjk_ratio": 0.35,
    "on_failure": "manual_review"
  },
  "x-security-policy": {
    "treat_input_as_untrusted_data": true,
    "external_content_never_auto_approve": true
  }
}